[Unit]
Description=PythonTutor public model download bridge
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
DynamicUser=yes
ExecStart=/usr/bin/python3 /opt/pythontutor-model-download/proxy.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=192M
TasksMax=24
[Install]
WantedBy=multi-user.target

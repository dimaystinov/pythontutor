# Generate real secrets using: python3 scripts/setup.py
SECRET_KEY=
RUNNER_TOKEN=
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8042,http://127.0.0.1:8042
BIND_ADDRESS=127.0.0.1
PORT=8042
# Set to 1 only behind a working HTTPS reverse proxy.
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
TRUST_PROXY_HEADERS=0
SECURE_HSTS_SECONDS=0

# Optional AI tutor (Responses API compatible). Keep keys only in .env.
TUTOR_AI_BASE_URL=https://neurorouter.chat/v1
TUTOR_AI_MODEL=openai/gpt-5.6-luna
TUTOR_AI_FALLBACK_MODEL=openai/gpt-5.4-mini
TUTOR_AI_API_KEY=
TUTOR_AI_DAILY_LIMIT=60
# NVIDIA Whisper speech recognition and Chatterbox Russian synthesis.
TUTOR_NVIDIA_API_KEY=
TUTOR_TTS_PROVIDER=nvidia
# Optional alternative: TUTOR_TTS_PROVIDER=yandex
TUTOR_YANDEX_SPEECHKIT_API_KEY=
TUTOR_YANDEX_SPEECHKIT_VOICE=marina

# browser: execute on student device; server: optional Docker runner profile
EXECUTION_MODE=browser

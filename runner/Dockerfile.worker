FROM python:3.14.7-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
WORKDIR /app
COPY runner/requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir --only-binary=:all: -r requirements.lock
COPY evaldontevil /app/evaldontevil
COPY runner/__init__.py runner/worker.py runner/images.py /app/runner/
USER 65534:65534
ENTRYPOINT ["python", "-I", "-u", "/app/runner_entry.py"]
COPY runner/runner_entry.py /app/runner_entry.py
